---
interface Props {
  class?: string;
  size?: number;
}
const { class: className, size = 22 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={["mt-0.5 shrink-0", className]}
  aria-hidden="true"
>
  <path d="M5 12.5l4.5 4.5L19 7"></path>
</svg>
